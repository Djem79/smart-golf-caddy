rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users — each user owns only their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Per-user share quota (userQuota/{uid}) — Admin SDK only. Clients must
    // never read or write this document; the shareRoundByEmail Cloud Function
    // is the sole writer.
    match /userQuota/{userId} {
      allow read, write: if false;
    }

    // Rounds — field-aware update rules split per action.
    match /rounds/{roundId} {

      // READ
      // `get` requires participation. The lobby-bypass exception was removed
      // because it exposed PII (full players map + emails + lobbyCode) to any
      // authenticated attacker. Join-by-code now goes through a callable
      // function (`joinLobbyByCode`) that uses Admin SDK.
      allow get: if request.auth != null
        && resource.data.playerIds is list
        && request.auth.uid in resource.data.playerIds;

      // `list` ДОЛЖЕН ссылаться на resource.data — иначе Firestore пропускает
      // неограниченный запрос и отдаёт все документы коллекции. С этим
      // условием проходит только запрос, гарантированно ограниченный своим
      // uid (getUserRounds: where playerIds array-contains uid), а голый
      // getDocs(collection('rounds')) отклоняется.
      //
      // ВАЖНО (проверено эмулятором): доп. проверка `resource.data.playerIds
      // is list` здесь ЛОМАЕТ статический query-prover Firestore — с ней
      // ЛЮБОЙ list, включая легитимный array-contains-запрос своего uid,
      // отклоняется как "недоказуемый". Без неё provability работает: чтобы
      // array-contains вообще совпал, поле обязано быть массивом, так что
      // type-guard здесь избыточен и его отсутствие безопасно.
      allow list: if request.auth != null
        && request.auth.uid in resource.data.playerIds;

      // CREATE — host creates a round with themselves as the only player.
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.playerIds is list
        && request.resource.data.playerIds.size() == 1
        && request.resource.data.playerIds[0] == request.auth.uid
        && request.resource.data.status in ['lobby', 'active']
        && request.resource.data.totalHoles in [9, 18]
        // Создатель кладёт в players только себя; server-only поля запрещены —
        // иначе фиктивный players открывал бы обход allowlist в shareRoundByEmail.
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && !request.resource.data.keys()
            .hasAny(['emailedAt', 'emailingStartedAt', 'emailedTo', 'emailResults']);

      // UPDATE — one of three per-action rules must match. JOIN now happens
      // ONLY through the joinLobbyByCode callable (Admin SDK, bypasses rules),
      // so clients may never write `players` — this closes a PII-forgery
      // vector where any lobby participant could rewrite another player's
      // name/avatar/email (and thus redirect their summary email). Shot
      // recording is likewise a callable. `holes` and the email/* fields are
      // server-owned. All of these are blocked from client writes below.
      allow update: if request.auth != null
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['players', 'holes', 'emailedAt', 'emailingStartedAt', 'emailedTo', 'emailResults'])
        && (
          // 1. LEAVE — пользователь убирает ИМЕННО И ТОЛЬКО себя.
          //    Без проверки равенства множеств участник мог бы под видом
          //    выхода выкинуть хоста/других или вписать чужой uid.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds'])
            && (request.auth.uid in resource.data.playerIds)
            && request.resource.data.playerIds is list
            && request.resource.data.playerIds.toSet() ==
               resource.data.playerIds.toSet().difference([request.auth.uid].toSet())
          )
          // 2. START — host transitions lobby → active
          || (
            resource.data.hostId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt'])
            && resource.data.status == 'lobby'
            && request.resource.data.status == 'active'
          )
          // 3. FINISH — host transitions active → finished
          || (
            resource.data.hostId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'finishedAt'])
            && resource.data.status == 'active'
            && request.resource.data.status == 'finished'
          )
        );

      // DELETE — host only
      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;
    }
  }
}
