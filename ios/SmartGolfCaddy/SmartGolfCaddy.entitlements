<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple (App Store 4.8). Требует платной команды
	     разработчика: с бесплатной Personal Team сборка на устройство
	     упадёт на провижининге; сборка на симулятор проходит всегда. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- App Attest для Firebase App Check в release-сборках. production, а
	     не development: App Check не принимает токены sandbox-окружения
	     (TestFlight/App Store и так работают в production). Debug-сборки
	     используют AppCheckDebugProviderFactory и этот ключ не трогают. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
